{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaveprofiler.local/schemas/scan-selection.schema.json",
  "title": "Weaveprofiler instrumentation selection",
  "description": "Selection document accepted by 2_instrument/generate_edits.py. Each selection uses exactly one boundary mode: begin/end anchors or begin/end lines.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "selections"
  ],
  "properties": {
    "schema": {
      "const": "weaveprofiler-instrument-selection/v1"
    },
    "version": {
      "const": 1
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/selection"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semanticId": {
      "enum": [
        "load",
        "wait",
        "mma",
        "compute",
        "epilogue",
        "store",
        "barrier",
        "dispatch",
        "communication",
        "gemm",
        "attention",
        "reduction",
        "moe",
        "convolution",
        "megakernel",
        "softmax"
      ]
    },
    "selection": {
      "type": "object",
      "required": [
        "path",
        "semantic_id",
        "aux"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[\\s\\S]+$"
            },
            {
              "not": {
                "anyOf": [
                  {
                    "pattern": "//"
                  },
                  {
                    "pattern": "/$"
                  },
                  {
                    "pattern": "^[A-Za-z]:"
                  },
                  {
                    "pattern": "\\u0000"
                  }
                ]
              }
            }
          ]
        },
        "semantic_id": {
          "$ref": "#/$defs/semanticId"
        },
        "begin_anchor": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "end_anchor": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\\u0000"
          }
        },
        "begin_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "expect_count": {
          "type": "integer",
          "minimum": 1
        },
        "aux": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "not": {
                    "pattern": "[\\u0000\\r\\n;{}]"
                  }
                }
              ]
            },
            {
              "type": "integer"
            }
          ]
        },
        "event_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4095
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "begin_anchor",
                "end_anchor"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "begin_line"
                    ]
                  },
                  {
                    "required": [
                      "end_line"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "begin_line",
                "end_line"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "begin_anchor"
                    ]
                  },
                  {
                    "required": [
                      "end_anchor"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
