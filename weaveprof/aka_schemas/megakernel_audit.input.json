{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "weaveprofiler.megakernel-audit.input",
  "type": "object",
  "properties": {
    "workspace": {"type": "string", "minLength": 1},
    "entry_source": {"type": "string", "minLength": 1},
    "bench_cmd": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "build_cmd": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "items": {"type": "string"}, "minItems": 1}
      ]
    },
    "inst_files": {"type": "object"},
    "inst_dir": {"type": "string"},
    "dump_path": {"type": "string"},
    "names": {"oneOf": [{"type": "string"}, {"type": "object"}]},
    "runtime_metrics": {"oneOf": [{"type": "string"}, {"type": "object"}]},
    "nsys_sqlite": {"type": "string"},
    "card": {"type": "string"},
    "arch": {"type": "string"},
    "total_sms": {"type": "integer", "minimum": 1},
    "limit": {"type": "number", "minimum": 0, "maximum": 0.5},
    "out_dir": {"type": "string"},
    "gpu_id": {"type": "string"},
    "use_l0_cache": {"type": "boolean"}
  },
  "required": ["workspace", "entry_source"],
  "additionalProperties": true
}
