        "operator_level": {
          "type": "boolean"
        },
        "source_recognition": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "recorder": {
          "$ref": "#/$defs/semanticRecorder"
        },
        "parameterization": {
          "$ref": "#/$defs/parameterization"
        },
        "correctness_hazards": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "evidence": {
          "$ref": "#/$defs/semanticEvidence"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/semanticIdentity"
        },
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "measured"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "status": {
                    "const": "measured"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "compiled"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "status": {
                    "const": "compiled"
                  },
                  "supporting_constructs": {
                    "minItems": 1
                  },
                  "isa_mnemonics": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "simulated"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "status": {
                    "const": "simulated"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "unverified"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "status": {
                    "const": "unverified"
                  },
                  "isa_mnemonics": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        }
      ]
    }
