      "type": "object",
      "required": [
        "semantic_id",
        "display_name",
        "kind",
        "attribution",
        "description",
        "operator_level",
        "source_recognition",
        "placement",
        "recorder",
        "parameterization",
        "correctness_hazards",
        "validation",
        "evidence_status",
        "evidence"
      ],
      "properties": {
        "semantic_id": {
          "$ref": "#/$defs/knownSemanticId"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "operator",
            "shared",
            "phase"
          ]
        },
        "attribution": {
          "enum": [
            "compute",
            "load",
            "wait",
            "store",
            "control",
            "memory",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
