{
  "schema": "weaveprofiler-hw-metrics/v1",
  "keep": [
    "SMs Active",
    "SM Issue",
    "Tensor Active",
    "SM Tensor Pipe Active (HMMA ops)",
    "DRAM Read Bandwidth",
    "DRAM Write Bandwidth"
  ],
  "required": ["SMs Active", "SM Issue", "Tensor Active"],
  "combine": [
    {
      "name": "DRAM Bandwidth Total",
      "sum_of": ["DRAM Read Bandwidth", "DRAM Write Bandwidth"],
      "unit": "%",
      "drop_sources": false,
      "rationale": "DRAM 读写共享物理接口，保留方向曲线并给出总带宽。"
    }
  ],
  "scale": [
    {
      "name": "Tensor Active",
      "factor": 4.0,
      "device_name_regex": "(?i)\\bH20\\b",
      "derived_name": "Tensor Active (H20-corrected x4)",
      "rationale": "H20 Tensor 峰值按完整 GH100 归一；保留原始曲线并生成 x4 校正曲线。"
    }
  ]
}
